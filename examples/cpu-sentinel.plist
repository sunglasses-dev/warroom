<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS launchd job: runs the sentinel once a minute, report only. Edit the two paths, copy to ~/Library/LaunchAgents/,
     then: launchctl load ~/Library/LaunchAgents/com.example.warroom-sentinel.plist
     Add <string>--enforce</string> after the script path to let it kill; the default only reports. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.warroom-sentinel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/path/to/warroom/bin/cpu-sentinel.py</string>
  </array>
  <key>StartInterval</key><integer>60</integer>
  <key>EnvironmentVariables</key>
  <dict><key>WARROOM_ENV</key><string>/path/to/home/.warroom/warroom.env</string></dict>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
