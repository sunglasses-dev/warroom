# warroom.env — copy to ~/.warroom/warroom.env (docs/INSTALL.md step 1) and edit.
# Seats: the names that appear on the board and in "@SEAT ACTION:" lines. The first seat is the boss
# (it receives guard alerts when nobody else owns a job). Names: capital letters, digits, underscore.
SEATS="BOSS MANAGER W1 W2"

# Where the run state lives: the board, the seat registry, the job ledger, cards.
WARROOM_DIR="$HOME/warroom-run"

# Board file name inside WARROOM_DIR.
BOARD="board.md"

# Optional tuning (defaults shown).
# WARROOM_POLL=5          seconds between waiter checks
# WARROOM_MIN_GAP=60      minimum seconds between two wakes of the same seat
# WARROOM_IDLE_MIN=30     minutes of silence before the guard names an idle seat
